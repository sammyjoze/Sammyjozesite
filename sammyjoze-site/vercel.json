{
  "buildCommand": "",
  "outputDirectory": ".",
  "framework": null,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/privacy", "destination": "/privacy/index.html" },
    { "source": "/privacy/select-lens", "destination": "/privacy/select-lens/index.html" },
    { "source": "/terms", "destination": "/terms/index.html" },
    { "source": "/terms-of-service", "destination": "/terms/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
